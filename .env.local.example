# Copiar este archivo a .env.local y completar con las credenciales del proyecto
# de Supabase (Project Settings > API en supabase.com).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para uso en el servidor (Route Handlers / Server Actions). Nunca exponer
# en el cliente ni commitear con un valor real.
SUPABASE_SERVICE_ROLE_KEY=
