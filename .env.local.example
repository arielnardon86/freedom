# Copiar este archivo a .env.local y completar.

# Cadena de conexión a Postgres.
# - Local (ver README): postgres://arinardon@localhost:5433/freedom_fotografia
# - Clever Cloud: el valor de POSTGRESQL_ADDON_URI del addon (Console > tu app
#   de Postgres > Information).
DATABASE_URL=

# String random para firmar la cookie de sesión (JWT). Generarlo una sola vez,
# por ejemplo con: openssl rand -base64 32
SESSION_SECRET=
