# Copiar este archivo a .env.local y completar.

# Cadena de conexión a Postgres.
# - Local (ver README): postgres://arinardon@localhost:5433/freedom_fotografia
# - Clever Cloud: el valor de POSTGRESQL_ADDON_URI del addon (Console > tu app
#   de Postgres > Information).
DATABASE_URL=

# String random para firmar la cookie de sesión (JWT). Generarlo una sola vez,
# por ejemplo con: openssl rand -base64 32
SESSION_SECRET=

# API key de Google Drive, para mostrar dentro del sitio las fotos de la
# carpeta de cada evento (la carpeta ya tiene que estar compartida como
# "cualquiera con el link puede ver"). No requiere autorizar nada de tu
# cuenta de Drive, solo identifica la app ante Google:
#   1. https://console.cloud.google.com/ > crear proyecto (o usar uno)
#   2. APIs & Services > Library > buscar "Google Drive API" > Enable
#   3. APIs & Services > Credentials > Create Credentials > API key
GOOGLE_DRIVE_API_KEY=
